# The repo root is the docker build context of `app/`'s snapshot build
# (cartesi.toml sets context = ".." so the bun workspace resolves inside the
# build). Keep the context down to what that build reads.
.git
**/node_modules
**/dist
app/.cartesi
devnet/snapshot
devnet/logs
devnet/deployment
contracts/out
contracts/cache
contracts/dependencies
bin
op-cartesi
