{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],

        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,

        // Node 22 runs the .ts sources directly via type stripping, so only
        // erasable syntax is allowed (no enums, namespaces, parameter
        // properties), and local imports keep their explicit .ts extensions.
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,

        // tsc only typechecks; tsdown emits dist/.
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src", "test", "tsdown.config.ts"]
}
