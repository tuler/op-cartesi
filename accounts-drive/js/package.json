{
  "name": "@cartesi/accounts",
  "version": "0.1.0",
  "description": "TypeScript implementation of the Cartesi Accounts Drive Format v1 (docs/ACCOUNTS-DRIVE-SPEC.md).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.14",
    "tsdown": "^0.15.9",
    "typescript": "^5.9.3"
  }
}
